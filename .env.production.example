# 生产环境变量示例（复制为 .env 或由 K8s Secret / Vault 注入，勿提交真实值）
SPRING_PROFILES_ACTIVE=prod

# JWT（HS256，UTF-8 至少 32 字节；轮换后旧 Token 立即失效）
# 生成：openssl rand -base64 48
NKCTF_JWT_SECRET=

NKCTF_DB_URL=jdbc:postgresql://your-db-host:5432/nkctf
NKCTF_DB_USERNAME=nkctf
NKCTF_DB_PASSWORD=

NKCTF_REDIS_HOST=your-redis-host
NKCTF_REDIS_PORT=6379
NKCTF_REDIS_PASSWORD=

# Refresh Cookie（HTTPS 站点）
NKCTF_COOKIE_DOMAIN=.example.com

# 逗号分隔，覆盖 SecurityConfig 默认 CORS（若配置此项）
# NKCTF_CORS_ORIGINS=https://www.example.com,https://example.com

# Docker：生产使用 Unix socket，挑战容器仅绑定 0.0.0.0:<随机>:80
# SPRING_PROFILES_ACTIVE=prod 时 application-prod.yml 已配置 docker.host / bind-host
